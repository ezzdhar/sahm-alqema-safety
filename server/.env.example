# ==========================================
# Sahm Al Qemma Email Server Configuration
# Target: info@sahmalqemma.sa
# ==========================================

PORT=3001
NODE_ENV=production

# Target Email (Where contact forms are delivered)
TARGET_EMAIL=info@sahmalqemma.sa

# SMTP Settings
# Example for cPanel / Webmail / Hostinger / Namecheap / Private Email:
SMTP_HOST=mail.sahmalqemma.sa
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@sahmalqemma.sa
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM=info@sahmalqemma.sa

# Example for Google Workspace / Gmail (requires App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-app-password

# Example for Microsoft 365 / Outlook:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@sahmalqemma.sa
# SMTP_PASS=YourEmailPasswordHere
